{
  "name": "aom-online-madrasa-server",
  "version": "1.0.0",
  "description": "AOM Online Madrasa management system backend (Express + TypeScript modular)",
  "main": "dist/server.js",
  "scripts": {
    "start:prod": "node init && node ./dist/server.js",
    "start:dev": "node init && ts-node-dev --respawn --transpile-only --ignore-watch uploads src/server.ts",
    "build": "node init && tsc",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prettier": "prettier --write \"./src/**/*.+(ts|json)\"",
    "fix:urls": "npx ts-node src/scripts/fixUploadUrls.ts",
    "seed:admin": "npx ts-node src/scripts/seedAdmin.ts",
    "seed:demo": "npx ts-node src/scripts/seedDemo.ts",
    "seed:settings": "npx ts-node src/scripts/seedSettings.ts",
    "seed:classes": "npx ts-node src/scripts/seedClasses.ts",
    "seed:phase5": "npx ts-node src/scripts/seedPhase5.ts",
    "seed:payments": "npx ts-node src/scripts/seedPayments.ts",
    "seed:attendance": "npx ts-node src/scripts/seedAttendance.ts",
    "seed:phase8": "npx ts-node src/scripts/seedPhase8.ts"
  },
  "keywords": [
    "madrasa",
    "express",
    "typescript",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.3.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
