PORT=5000
DATABASE_URL=your_mongodb_connection_string
BCRYPT_SALT_ROUNDS=12

# JWT
JWT_ACCESS_SECRET=your_access_token_secret
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=7d

# Seed superAdmin (used by npm run seed:admin)
SUPER_ADMIN_EMAIL=superadmin@aom.com
SUPER_ADMIN_PASSWORD=Admin@12345

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Client
CLIENT_URL=http://localhost:3000

# Email (SMTP) — optional. Leave blank in dev; notifications log instead of
# sending an email until these are filled in.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# WhatsApp (Meta Cloud API) — optional, same drop-in-later behavior as SMTP.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Environment
NODE_ENV=development
